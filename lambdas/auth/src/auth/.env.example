NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matc84

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=example-client-id
# Optional: set only for LocalStack or another local AWS-compatible endpoint.
# If your LocalStack returns 501 for cognito-idp, upgrade/enable Cognito or use real AWS Cognito.
# AWS_ENDPOINT_URL=http://localhost:4566

# Optional dev/admin helper. Keep disabled in production.
AUTH_ADMIN_CONFIRM_ENABLED=false
AUTH_ADMIN_CONFIRM_SECRET=change-me-only-for-local-dev

AUTH_REGISTRATION_DLQ_URL=https://sqs.us-east-1.amazonaws.com/000000000000/auth-registration-dlq
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=100
DB_RETRY_MAX_DELAY_MS=2000

SWAGGER_ENABLED=true
SWAGGER_TITLE=Authentication API
SWAGGER_DESCRIPTION=User registration and authentication API
SWAGGER_VERSION=1.0.0
