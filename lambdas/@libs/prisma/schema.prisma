generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "produtos", "pedidos", "pagamentos"]
}

enum OrderStatus {
  pending
  cancelled
  paid
  refund_pending
  completed

  @@schema("pedidos")
}

model User {
  id         String   @id @default(uuid())
  cognitoSub String   @unique @map("cognito_sub")
  name       String
  email      String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@schema("auth")
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String
  price       Decimal   @db.Decimal(10, 2)
  amount      Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("products")
  @@schema("produtos")
}

model Order {
  id        String      @id @default(uuid())
  clientId  String      @map("client_id")
  status    OrderStatus @default(pending)
  products  Json
  total     Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("orders")
  @@schema("pedidos")
}

model Payment {
  id               String   @id @default(uuid())
  paymentAttemptId String   @map("payment_attempt_id")
  orderId          String   @map("order_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([paymentAttemptId])
  @@index([orderId])
  @@map("payments")
  @@schema("pagamentos")
}
